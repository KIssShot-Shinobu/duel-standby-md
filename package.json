{
  "name": "rtxzy-md-clean",
  "version": "1.1.7",
  "description": "Clean-room WhatsApp Multi-Device bot (Baileys) dengan arsitektur plugin bergaya RTXZY-MD",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch main.js",
    "smoke": "node main.js --no-connect --health --test",
    "check": "node scripts/check-syntax.js",
    "commands": "node scripts/list-commands.mjs",
    "commands:md": "node scripts/list-commands.mjs --markdown",
    "check:ytdlp": "node scripts/ytdlp-check.mjs",
    "check:sticker": "node scripts/sticker-check.mjs",
    "check:ygo": "node scripts/ygoprodeck-check.mjs",
    "check:quiz": "node scripts/yugioh-quiz-check.mjs",
    "test": "node --test"
  },
  "keywords": [
    "whatsapp-bot",
    "whatsapp",
    "baileys",
    "multi-device",
    "botcahx",
    "rtxzy"
  ],
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "awesome-phonenumber": "^7.8.0",
    "file-type": "^19.0.0",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.1.3",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "yt-search": "^2.10.3"
  }
}
