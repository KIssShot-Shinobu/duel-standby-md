# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Semua nilai bisa juga diisi lewat environment variable (panel/VPS/Docker).

# ── Identitas bot ─────────────────────────────────────────────
BOT_NAME="RTXZY Clean"
PREFIX=".#!/,"
# Nomor owner, pisahkan dengan koma bila lebih dari satu (format internasional tanpa +)
OWNER_NUMBER="628xxxxxxxxxx"
MODS_NUMBER=""
PREMIUM_NUMBER=""
OWNER_NAME="Owner"
STICKER_PACKNAME="RTXZY Clean"
STICKER_AUTHOR="Bot WhatsApp"

# ── Sesi WhatsApp ─────────────────────────────────────────────
# Nomor yang dipakai pairing code (wajib kalau login pakai --pair, format 628xxx)
PAIRING_NUMBER=""
# Folder kredensial Baileys (multi-file auth state)
SESSION_DIR="sessions"

# ── Server / health ───────────────────────────────────────────
# Kosongkan untuk port acak
PORT=""
LOG_LEVEL="info"

# ── Database ──────────────────────────────────────────────────
DB_FILE="database/database.json"
DB_SAVE_INTERVAL="10000"

# ── REST API opsional (untuk plugin downloader/stalker) ───────
# Bot ini TIDAK wajib API key. Plugin yang butuh API akan bilang sendiri bila kosong.
API_BASE=""
API_KEY=""

# ── AI opsional (OpenAI-compatible) ──────────────────────────
AI_BASE="https://api.openai.com/v1"
AI_KEY=""
AI_MODEL="gpt-4o-mini"

# ── Limit harian ─────────────────────────────────────────────
LIMIT_FREE="20"
LIMIT_PREMIUM="100"

# ── Tool eksternal: yt-dlp (untuk .ytmp3 / .ytmp4) ───────────
# Kosongkan kalau yt-dlp sudah ada di PATH (panel biasanya /usr/local/bin/yt-dlp)
YTDLP_PATH=""
# Batas durasi (detik) & tinggi maksimum video yang boleh diunduh
YTDLP_MAX_DURATION="900"
YTDLP_MAX_HEIGHT="720"
# Kalau YouTube minta verifikasi "bukan bot", ekspor cookies browser ke file
# (format Netscape cookies.txt) lalu isi path-nya di sini:
YTDLP_COOKIES=""
# Argumen tambahan, mis: --extractor-args "youtube:player_client=android"
YTDLP_ARGS=""
