# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Semua nilai bisa juga diisi lewat environment variable (panel/VPS/Docker).

# ── Identitas bot ─────────────────────────────────────────────
BOT_NAME="Duel Standby"
PREFIX=".#!/,"
# Nomor owner, pisahkan dengan koma bila lebih dari satu (format internasional tanpa +)
OWNER_NUMBER="628xxxxxxxxxx"
MODS_NUMBER=""
PREMIUM_NUMBER=""
OWNER_NAME="Owner"
STICKER_PACKNAME="Duel Standby"
STICKER_AUTHOR="Shinobu"

# ── Sesi WhatsApp ─────────────────────────────────────────────
# Nomor yang dipakai pairing code (wajib kalau login pakai --pair, format 628xxx)
PAIRING_NUMBER=""
# Folder kredensial Baileys (multi-file auth state)
SESSION_DIR="sessions"

# ── Server / health ───────────────────────────────────────────
# Kosongkan untuk port acak
PORT=""
LOG_LEVEL="info"

# ── Database ──────────────────────────────────────────────────
DB_FILE="database/database.json"
DB_SAVE_INTERVAL="10000"

# ── REST API opsional (untuk plugin downloader/stalker) ───────
# Bot ini TIDAK wajib API key. Plugin yang butuh API akan bilang sendiri bila kosong.
API_BASE=""
API_KEY=""

# ── AI opsional (OpenAI-compatible) ──────────────────────────
AI_BASE="https://api.openai.com/v1"
AI_KEY=""
AI_MODEL="gpt-4o-mini"
# Perilaku AI khusus OWNER: reply/tag bot -> jawab sebagai waifu (default Shinobu).
# AI_OWNER_ENABLED="true"
# AI_OWNER_MODEL=""            # kosong = pakai AI_MODEL
# AI_OWNER_HISTORY="50"        # seberapa panjang riwayat yang diingat owner
# AI_OWNER_FILE="database/owner-ai.json"
# AI_OWNER_PERSONA="Kamu waifu yang mencintai owner..."   # kosong = persona Shinobu bawaan

# ── Limit harian ─────────────────────────────────────────────
LIMIT_FREE="20"
LIMIT_PREMIUM="100"

# ── Hadiah tiap pesan chat (XP & saldo acak) ─────────────────
# Set CHAT_REWARD="false" untuk mematikan hadiah per pesan
CHAT_REWARD="true"
CHAT_XP_MIN="1"
CHAT_XP_MAX="9"
CHAT_SALDO_MIN="1"
CHAT_SALDO_MAX="9"
# Jeda minimum antar hadiah per user (ms). 0 = tiap pesan dapat hadiah
CHAT_REWARD_COOLDOWN="0"
# Catat perolehan xp/saldo di terminal saja (tidak ada pesan ke user)
CHAT_REWARD_LOG="true"
# Kirim pesan ke chat saat user naik level (default "false" = cukup di terminal)
CHAT_LEVELUP_NOTICE="false"

# ── Tool eksternal: yt-dlp (untuk .ytmp3 / .ytmp4) ───────────
# Kosongkan kalau yt-dlp sudah ada di PATH (panel biasanya /usr/local/bin/yt-dlp)
YTDLP_PATH=""
# Batas durasi (detik) & tinggi maksimum video yang boleh diunduh
YTDLP_MAX_DURATION="900"
YTDLP_MAX_HEIGHT="720"
# Kalau YouTube minta verifikasi "bukan bot", ekspor cookies browser ke file
# (format Netscape cookies.txt) lalu isi path-nya di sini:
YTDLP_COOKIES=""
# Argumen tambahan, mis: --extractor-args "youtube:player_client=android"
YTDLP_ARGS=""

# ── Gambar anime: .sfw (aman) & .nsfw (18+) ──────────────────
# Urutan provider, dipisah koma. Pilihan: nekosbest, danbooru, yandere, safebooru, purrbot
# (semuanya gratis tanpa API key — lihat docs/NSFW-API-RESEARCH.md)
IMAGE_PROVIDERS="nekosbest,danbooru,yandere,safebooru,purrbot"
NSFW_PROVIDERS="danbooru,yandere,purrbot"
# Tag yang ditolak di input & disaring dari hasil. Kosongkan untuk memakai daftar bawaan
# (loli, shota, child, cub, dll — konten anak tidak boleh, tanpa pengecualian).
IMAGE_BLOCKED_TAGS=""
# Batas ukuran gambar yang diunduh (byte) & jumlah hasil yang diminta ke booru
IMAGE_MAX_BYTES="8388608"
IMAGE_LIMIT_POSTS="30"
# Cache gambar lokal (biar tidak mengunduh berulang)
IMAGE_CACHE_DIR="database/cache/images"
IMAGE_CACHE_MAX="200"
# Catatan: kategori nsfw tetap MATI sampai owner menjalankan `.category nsfw on`.

# ── Sewa bot per grup (rent) ─────────────────────────────────
# Grup tanpa sewa aktif terkunci (kecuali yugioh & stiker + menu).
RENT_ENABLED="true"
# Durasi 1 bulan dalam hari
RENT_DAYS="30"
# Harga sewa per bulan (0 = owner set lewat `.rent list`/`.rent price`)
RENT_PRICE="0"
# Gambar QRIS tempat pembayaran (relatif folder bot)
RENT_QRIS="assets/qris.jpg"
# Nomor (tanpa +) untuk link wa.me bantuan sewa yang tampil di menu rent
RENT_HELP_NUMBER="628970080509"
# Pengingat H-berapa sebelum expired, dipisah koma
RENT_REMINDER_DAYS="3,1"
# Pesan saat fitur dikunci karena belum sewa
RENT_GATED_MSG="🔒 Fitur ini butuh sewa aktif. Ketik `.rent` untuk menyewa."

